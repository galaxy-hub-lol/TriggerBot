-- TRIGGERBOT LOGIC
local function isEnemy(targetModel)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character == targetModel then
			local hum = targetModel:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then
				return false
			end
			if plr.Team and LP.Team and plr.Team == LP.Team then
				return false
			end
			return true
		end
	end
	return false
end

local function fireEquippedTool()
	local char = LP.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then return end

	if typeof(tool.Activate) == "function" then
		tool:Activate()
	end
end

RunService.RenderStepped:Connect(function()
	if not triggerEnabled then return end
	if not Camera then Camera = Workspace.CurrentCamera end
	if not Camera then return end

	local char = LP.Character
	if not char then return end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {char}

	local centerViewport = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
	local unitRay = Camera:ViewportPointToRay(centerViewport.X, centerViewport.Y)
	local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rayParams)

	if result and result.Instance then
		local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
		if hitModel and isEnemy(hitModel) then
			local now = os.clock()
			if now - lastShot >= triggerCooldown then
				lastShot = now
				fireEquippedTool()
			end
		end
	end
end)

-- PERMANENT VISUAL NAME ESP
local Connections = {}

local function removeESP(plr)
	local character = plr.Character
	if not character then return end

	local head = character:FindFirstChild("Head")
	if head then
		local tag = head:FindFirstChild("GalaxyHubNameESP")
		if tag then tag:Destroy() end
	end
end

local function createESP(plr,character)
	if plr == LP then return end

	local head = character:WaitForChild("Head",5)
	if not head or not character.Parent then return end

	removeESP(plr)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GalaxyHubNameESP"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(180,35)
	billboard.StudsOffset = Vector3.new(0,2.5,0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local name = Instance.new("TextLabel")
	name.Size = UDim2.fromScale(1,1)
	name.BackgroundTransparency = 1
	name.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
	name.TextColor3 = Color3.fromRGB(190,145,255)
	name.TextStrokeTransparency = 0.15
	name.Font = Enum.Font.GothamBold
	name.TextSize = 12
	name.Parent = billboard
end

local function setupPlayer(plr)
	if plr == LP then return end

	if Connections[plr] then
		Connections[plr]:Disconnect()
	end

	Connections[plr] = plr.CharacterAdded:Connect(function(character)
		task.wait(0.3)
		createESP(plr,character)
	end)

	if plr.Character then
		task.spawn(createESP,plr,plr.Character)
	end
end

for _,plr in ipairs(Players:GetPlayers()) do
	setupPlayer(plr)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(plr)
	removeESP(plr)

	if Connections[plr] then
		Connections[plr]:Disconnect()
		Connections[plr] = nil
	end
end)

